{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep", "Agent",
      "Bash(poetry run pytest*)", "Bash(poetry run ruff*)", "Bash(poetry run mypy*)",
      "Bash(poetry run bandit*)", "Bash(poetry run pip-audit*)", "Bash(poetry run canoa-data-validate*)",
      "Bash(poetry run python*)", "Bash(poetry install*)", "Bash(poetry lock*)", "Bash(poetry build*)",
      "Bash(make *)", "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add -- *)",
      "Bash(git commit*)", "Bash(git switch*)", "Bash(git checkout -b*)", "Bash(git branch*)",
      "Bash(git stash*)", "Bash(ls*)", "Bash(tree*)", "Bash(cat*)", "Bash(wc*)", "Bash(python -m json.tool*)"
    ],
    "deny": [
      "Bash(git push*)", "Bash(git reset --hard*)", "Bash(git clean*)", "Bash(rm -rf /*)",
      "Bash(poetry publish*)", "Bash(twine*)", "Read(./.env)", "Read(./**/.env*)",
      "Bash(git -C *)", "Bash(git remote *)", "Bash(git checkout -- .)", "Bash(git restore .)",
      "Bash(git branch -D *)", "Bash(find * -delete*)", "Bash(gh pr merge*)", "Bash(gh release*)",
      "Bash(curl * | *)", "Bash(wget *)", "Bash(chmod -R 777*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bash .claude/hooks/guard-bash.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "bash .claude/hooks/format-python.sh" } ] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "bash .claude/hooks/stop-check.sh" } ] }
    ]
  },
  "env": { "PYTHONDONTWRITEBYTECODE": "1", "PYTHONUTF8": "1" }
}
